# Optional overrides for llm.config.json. Never prefix these with NEXT_PUBLIC_.
# Leave blank to use llm.config.json, or to disable chat when that file is blank too.
LLM_API_KEY=
# OpenAI-compatible API root, e.g. https://api.openai.com/v1 (not /chat/completions).
LLM_BASE_URL=
LLM_MODEL=
# Optional additional server-side coaching instructions. Do not put secrets here.
LLM_SYSTEM_PROMPT=
